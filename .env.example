# Copy to .env and change the passwords/secrets. Do not quote values or put spaces around '='.
GATEWAY_PORT=80
TRAEFIK_DASHBOARD_PORT=8090

AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres_the_superuser

USER_DB_NAME=user_db
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres_the_superuser

DEVICE_DB_NAME=device_db
DEVICE_DB_USER=postgres
DEVICE_DB_PASSWORD=postgres_the_superuser

MONITORING_DB_NAME=monitoring_db
MONITORING_DB_USER=postgres
MONITORING_DB_PASSWORD=postgres_the_superuser

# RabbitMQ: two independent brokers
# Synchronization Broker (user/device events between microservices) - only reachable inside Docker
SYNC_MQ_USER=sync
SYNC_MQ_PASSWORD=change-me-sync
SYNC_MQ_MANAGEMENT_PORT=15672
# Data Collection Broker (smart meter readings) - AMQP port is published so the desktop simulator can connect
DATA_MQ_USER=simulator
DATA_MQ_PASSWORD=change-me-data
DATA_MQ_PORT=5672
DATA_MQ_MANAGEMENT_PORT=15673

# Security & Admin Config
JWT_SECRET=4c9a87d6e5f1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7
JWT_EXPIRATION_MINUTES=60

# First administrator, created at startup (password: at least 6 characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
